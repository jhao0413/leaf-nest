# Public app origin used by the browser during local development.
APP_URL=http://localhost:5173
API_PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leaf_nest
# Required for source development. Docker deployments may leave this empty;
# the container generates a secret and persists it in the app-data volume.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
# Optional comma-separated origins for additional browser entry points or packaged clients.
# Include every browser-facing origin you will use when it differs from APP_URL/BETTER_AUTH_URL.
# Example: http://localhost:8787,http://192.168.x.x:8787,tauri://localhost,http://tauri.localhost
TRUSTED_CLIENT_ORIGINS=
# Optional frontend API origin. Leave empty for same-origin browser usage.
# Set this when building the Tauri Android client against a deployed backend.
VITE_API_BASE_URL=
# Internal endpoint used by the backend to reach S3-compatible storage.
# In Docker Compose, this is mapped to RustFS through http://rustfs:9000.
S3_ENDPOINT=http://localhost:9000
# Public endpoint embedded into signed URLs returned to the browser.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=leaf-nest
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true

# Optional Docker Compose self-host overrides. `docker compose up -d` starts the
# complete local stack without this file. For direct IP deployments, set the public
# host once and Compose derives the app, auth, and public RustFS URLs automatically.
# SELF_HOST_PUBLIC_HOST=192.168.x.x
# LEAF_NEST_TAG=v0.4.0
#
# Use explicit URLs instead of SELF_HOST_PUBLIC_HOST for HTTPS, reverse proxies,
# custom ports, or separate domains. App and auth URLs must match the origin used
# in the browser; RustFS must be reachable by the browser.
# SELF_HOST_APP_URL=https://reader.example.com
# SELF_HOST_BETTER_AUTH_URL=https://reader.example.com
# SELF_HOST_S3_PUBLIC_ENDPOINT=https://objects.example.com
#
# The bundled PostgreSQL and RustFS services start by default. Set the corresponding
# replica count to 0 only when replacing that service with an external dependency.
# LOCAL_DB_REPLICAS=0
# LOCAL_STORAGE_REPLICAS=0
# External services on the Docker host can use host.docker.internal, for example:
# SELF_HOST_DATABASE_URL=postgres://postgres:postgres@host.docker.internal:54321/leaf_nest
# SELF_HOST_S3_ENDPOINT=http://host.docker.internal:9000
#
# Local credentials are optional and default to the values in docker-compose.yml.
# When overriding PostgreSQL credentials, use a URL-safe password; Compose uses the
# same POSTGRES_* values to build the application's local database URL automatically.
# POSTGRES_DB=leaf_nest
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=replace-with-a-url-safe-password
# RUSTFS_ACCESS_KEY=replace-with-a-rustfs-access-key
# RUSTFS_SECRET_KEY=replace-with-a-rustfs-secret-key
